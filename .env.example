# EchoMind-PM 环境变量配置示例
# 复制为 .env 并填入真实值

# ── LLM 模型：豆包（火山方舟 Ark）───────────────────────────────────────────
DOUBAO_API_KEY=your-ark-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 深度思考模型（复杂规划/跟踪/汇报用）
DOUBAO_MODEL=doubao-seed-evolving
# 快速模型（简单问候/查询用）
DOUBAO_FAST_MODEL=doubao-seed-2-0-mini-260428
# 接口模式：chat / responses
DOUBAO_API_MODE=chat
# 意图识别是否使用 LLM（true/false），深度模型慢时设 false 用关键词匹配
INTENT_USE_LLM=false

# ── 飞书集成（可选，配置后启用飞书机器人）─────────────────────────────────────
LARK_APP_ID=your-feishu-app-id
LARK_APP_SECRET=your-feishu-app-secret
# 多维表格 app_token 和 table_id（URL 中获取）
LARK_BASE_TOKEN=
LARK_TABLE_ID=
# 是否启用飞书同步
ENABLE_FEISHU_SYNC=false

# ── 服务 ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Skills ────────────────────────────────────────────────────────────────────
ECHOMIND_SKILLS_DIR=./skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000

# ── 项目数据存储 ──────────────────────────────────────────────────────────────
PROJECT_STORE_PATH=./data/projects.json
